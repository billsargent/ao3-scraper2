{
  "name": "ao3-offsite-pipeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "db:generate": "npm run db:generate -w @ao3-offsite/database",
    "db:migrate": "npm run db:migrate -w @ao3-offsite/database",
    "dataset:capture": "tsx scripts/capture-work-dataset.ts",
    "dataset:reprocess": "tsx scripts/reprocess-work-dataset.ts",
    "dataset:load": "tsx scripts/load-package-into-collector.ts",
    "worker:start": "npm run start -w @ao3-offsite/worker",
    "export-worker:start": "npm run start -w @ao3-offsite/export-worker",
    "planner-worker:start": "npm run start -w @ao3-offsite/planner-worker",
    "api:start": "npm run start -w @ao3-offsite/api",
    "web:dev": "npm run dev -w @ao3-offsite/web",
    "web:build": "npm run build -w @ao3-offsite/web",
    "test:e2e": "playwright test",
    "e2e:build-package": "tsx scripts/build-e2e-package.ts",
    "test:full-pipeline": "bash scripts/test-full-pipeline.sh",
    "production:up": "bash scripts/production-up.sh",
    "production:down": "bash scripts/production-down.sh",
    "production:backup": "bash scripts/backup-production.sh",
    "otw:up": "bash scripts/otw-private-up.sh",
    "otw:down": "bash scripts/otw-private-down.sh",
    "otw:import": "bash scripts/otw-private-import.sh",
    "otw:backup": "bash scripts/otw-private-backup.sh",
    "setup:all": "bash scripts/setup-all.sh",
    "services:start": "bash scripts/all-services.sh start all",
    "services:stop": "bash scripts/all-services.sh stop all",
    "services:status": "bash scripts/all-services.sh status all",
    "services:backup": "bash scripts/all-services.sh backup all",
    "docs:verify": "bash scripts/verify-docs.sh",
    "package:sample": "tsx apps/package-cli/src/index.ts sample",
    "package:sample-update": "tsx apps/package-cli/src/index.ts sample-update",
    "package:verify": "tsx apps/package-cli/src/index.ts verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.17.30",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
