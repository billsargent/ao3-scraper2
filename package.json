{
  "name": "ao3-offsite-pipeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "start": "bash scripts/all-services.sh start all",
    "stop": "bash scripts/all-services.sh stop all",
    "restart": "bash scripts/all-services.sh restart all",
    "status": "bash scripts/all-services.sh status all",
    "logs": "bash scripts/all-services.sh logs all",
    "backup": "bash scripts/all-services.sh backup all",
    "reset": "bash scripts/reset-all.sh",
    "setup": "bash scripts/setup-all.sh --start",
    "dev": "concurrently -n api,worker,planner,export,web -c auto \"npm run start -w @ao3-offsite/api\" \"npm run start -w @ao3-offsite/worker\" \"npm run start -w @ao3-offsite/planner-worker\" \"npm run start -w @ao3-offsite/export-worker\" \"npm run dev -w @ao3-offsite/web\"",
    "db:generate": "npm run db:generate -w @ao3-offsite/database",
    "db:migrate": "npm run db:migrate -w @ao3-offsite/database",
    "dataset:capture": "tsx scripts/capture-work-dataset.ts",
    "dataset:reprocess": "tsx scripts/reprocess-work-dataset.ts",
    "dataset:load": "tsx scripts/load-package-into-collector.ts",
    "web:build": "npm run build -w @ao3-offsite/web",
    "test:e2e": "playwright test",
    "e2e:build-package": "tsx scripts/build-e2e-package.ts",
    "test:full-pipeline": "bash scripts/test-full-pipeline.sh",
    "docs:verify": "bash scripts/verify-docs.sh",
    "package:sample": "tsx apps/package-cli/src/index.ts sample",
    "package:sample-update": "tsx apps/package-cli/src/index.ts sample-update",
    "package:verify": "tsx apps/package-cli/src/index.ts verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.17.30",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
