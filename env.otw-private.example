# Copy to .env.otw-private and replace passwords/tokens.
OTW_DIR=../otwarchive
OTW_WEB_PORT=3000
OTW_BIND_ADDRESS=127.0.0.1
OTW_APP_URL=http://localhost:3000
OTW_APP_HOST=localhost
OTW_APP_NAME='Private Offline Archive'
OTW_APP_SHORT_NAME='Offline AO3'
OTW_ARCHIVIST_LOGIN=offline_importer
OTW_ARCHIVIST_EMAIL=offline-importer@example.invalid
OTW_ARCHIVIST_PASSWORD=change-me-to-a-strong-password
# Enable only on a host with enough memory for Rails + Elasticsearch + Resque.
OTW_ENABLE_RESQUE=false
# Optional collector callback. Leave blank when collector API is unavailable.
# Production all-services mode uses the Nginx/API endpoint on port 8080.
COLLECTOR_CALLBACK_URL=http://host.docker.internal:8080/
COLLECTOR_API_TOKEN=
