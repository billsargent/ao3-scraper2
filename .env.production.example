# Copy to .env.production and replace every change-me value.
#
# The production runtime is a SINGLE container that runs MariaDB (inside the
# image, bound to 127.0.0.1 within the container), the Fastify API (serving both
# the React UI and the /api routes on port 8080), and the collector/planner/
# export workers. MariaDB is not exposed to the host.
MARIADB_ROOT_PASSWORD=change-me-root-password
COLLECTOR_DATABASE_NAME=ao3_collector
COLLECTOR_DATABASE_USER=collector
COLLECTOR_DATABASE_PASSWORD=change-me-url-safe-password
COLLECTOR_DATABASE_URL=mysql://collector:change-me-url-safe-password@127.0.0.1:3306/ao3_collector
API_TOKEN=change-me-to-at-least-32-random-characters
WEB_PORT=5678
APP_VERSION=local
DATA_DIR=./data
BACKUP_DIR=./backups
TZ=UTC
