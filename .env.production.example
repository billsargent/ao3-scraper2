# Copy to .env.production and replace every change-me value.
MARIADB_IMAGE=mariadb:10.11
MARIADB_ROOT_PASSWORD=change-me-root-password
COLLECTOR_DATABASE_NAME=ao3_collector
COLLECTOR_DATABASE_USER=collector
COLLECTOR_DATABASE_PASSWORD=change-me-url-safe-password
COLLECTOR_DATABASE_URL=mysql://collector:change-me-url-safe-password@collector-db:3306/ao3_collector
API_TOKEN=change-me-to-at-least-32-random-characters
WEB_PORT=8080
APP_VERSION=local
APP_UID=1000
APP_GID=1000
DATA_DIR=./data
BACKUP_DIR=./backups
TZ=UTC
