# Collector MariaDB. Keep this database and user separate from OTW Archive.
COLLECTOR_DATABASE_NAME=ao3_collector
COLLECTOR_DATABASE_USER=collector
COLLECTOR_DATABASE_PASSWORD=collector_local_only
COLLECTOR_DATABASE_PORT=3307
COLLECTOR_DATABASE_URL=mysql://collector:collector_local_only@localhost:3307/ao3_collector
MARIADB_ROOT_PASSWORD=local_root_only
MARIADB_IMAGE=mariadb:10.11

# Raw response storage
COLLECTOR_BLOB_DIRECTORY=./data/blobs

# Source settings. Do not lower the delay without coordination/permission.
SOURCE_ORIGIN=https://archiveofourown.org
SOURCE_MINIMUM_DELAY_MS=10000
SOURCE_DAILY_REQUEST_BUDGET=250
SOURCE_RUN_REQUEST_BUDGET=25
SOURCE_USER_AGENT=AO3-Offsite-Collector/0.1 contact-address-required
SOURCE_INCLUDE_ADULT=true

# Local API
API_HOST=127.0.0.1
API_PORT=3001

# Worker. The worker refuses placeholder contact details.
WORKER_MAXIMUM_FAILURE_ATTEMPTS=6
# WORKER_ID=collector-host-1
